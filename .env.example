# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at: github.com/settings/developers → "New OAuth App"
# Homepage URL:   http://localhost:3000   (or your Vercel URL in production)
# Callback URL:   http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=CodePlatoon

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Database (Turso) ──────────────────────────────────────────────────────────
# Local dev: leave blank — uses a local file (local.db)
# Production: get from turso.tech → create a database → copy URL + token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Pusher (real-time PvP) ────────────────────────────────────────────────────
# Free account at pusher.com → create a "Channels" app → copy credentials
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ── Frontend (Vite exposes VITE_ vars to the browser) ─────────────────────────
# Same as PUSHER_KEY and PUSHER_CLUSTER above
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=

# ── URLs ──────────────────────────────────────────────────────────────────────
# SERVER_URL is the root of your deployment (used in OAuth callback URL)
# Leave blank locally — Vercel sets this automatically in production
SERVER_URL=
CLIENT_URL=
