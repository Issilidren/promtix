# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at: github.com/settings/developers → "New OAuth App"
# Homepage URL:   https://your-app.up.railway.app
# Callback URL:   https://your-app.up.railway.app/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=CodePlatoon

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=fa063c0d7a9c77272117c54601a2e95325930c5f4fa3af5541a5a8de91fdb610

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Pusher (real-time PvP) ────────────────────────────────────────────────────
# Free account at pusher.com → create a "Channels" app
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ── Frontend env (Vite needs VITE_ prefix to expose to browser) ───────────────
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
